# Puerto del servidor HTTP
PORT=8080

# Origen permitido por CORS (p. ej. tu GitHub Pages o localhost en desarrollo)
FRONTEND_ORIGIN=http://localhost:5173

# Proveedor de base de datos para el repositorio de profesores:
# - "json": archivo local en backend/data/authorized_teachers.json (ideal para desarrollo local)
# - "firestore": Google Cloud Firestore (recomendado para producción en Cloud Run / Firebase)
DB_PROVIDER=json

# Email administrador inicial (se añade automáticamente si la base de datos está vacía)
INITIAL_ADMIN_EMAIL=profesor@iessierraalmijara.es

# Google OAuth2 Client ID (obtenido en Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Solo para desarrollo local: permite iniciar sesión de prueba sin necesitar un Client ID real de Google
ALLOW_DEV_AUTH=true

# Semilla criptográfica secreta para derivar los códigos de las 100 balizas
CONTROLS_SECRET_SEED=reemplaza-con-una-semilla-secreta-hexadecimal-de-64-caracteres
