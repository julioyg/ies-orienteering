# ============================================================================
# CONFIGURACIÓN DE DESPLIEGUE EN GOOGLE CLOUD (CLOUD RUN + FIRESTORE)
# Copia este archivo a "backend/.env.deploy" y rellena tus valores reales:
#   cp backend/.env.deploy.example backend/.env.deploy
# ============================================================================

# ID de tu proyecto en Google Cloud Console (p. ej. ies-orienteering-prod)
GCP_PROJECT_ID=tu-proyecto-gcp

# Región para Cloud Run (europe-southwest1 = Madrid, europe-west1 = Bélgica)
GCP_REGION=europe-southwest1

# Ubicación para Cloud Firestore (eur3 = Europa multirregión gratuita, o europe-southwest1)
FIRESTORE_LOCATION=eur3

# Nombre del servicio en Cloud Run
SERVICE_NAME=ies-orienteering-api

# Correo de Google del profesor administrador inicial (se añadirá automáticamente a Firestore)
INITIAL_ADMIN_EMAIL=profesor@iessierraalmijara.es

# OAuth 2.0 Client ID de Google (creado en Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Origen permitido por CORS (URL base de tu GitHub Pages, sin barra al final)
FRONTEND_ORIGIN=https://julioyg.github.io
