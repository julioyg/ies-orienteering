{
  "name": "ies-orienteering-backend",
  "version": "1.0.0",
  "description": "Backend con Clean Architecture para el Portal del Profesor de Orientación - IES Sierra Almijara",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "setup:gcp": "bash ./scripts/setup-gcp.sh",
    "deploy": "bash ./scripts/deploy-cloudrun.sh",
    "controls:sync": "node ./scripts/sync-controls.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vitest": "^2.1.5"
  }
}
